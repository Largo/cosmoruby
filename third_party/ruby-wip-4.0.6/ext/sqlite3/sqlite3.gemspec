# frozen_string_literal: true
#
# Static gemspec for the sqlite3 gem as vendored into CosmoRuby.
#
# The upstream gem has no committed .gemspec (it is generated by Rake from
# metadata), and its C extension is compiled statically into ruby.com rather
# than built by RubyGems. assemble_stdlib.sh scans third_party/ruby/{lib,ext}
# for *.gemspec files and installs each one as a *default gem* specification
# under /zip/lib/ruby/gems/4.0.0/specifications/default/, which is what makes
# `gem list` / Bundler / ocran see sqlite3 as provided by the interpreter.
#
# NOTE: no `extensions` and no runtime dependency on mini_portile2 -- the
# native part is already linked in, and mini_portile2 is only an upstream
# *build-time* dependency for compiling the bundled SQLite amalgamation.
# CosmoRuby links against third_party/sqlite3 (Cosmopolitan's SQLite) instead.

version = File.foreach(File.join(__dir__, "lib/sqlite3/version.rb")) do |line|
  /^\s*VERSION\s*=\s*"(.*)"/ =~ line and break $1
end rescue nil

Gem::Specification.new do |s|
  s.name = "sqlite3"
  s.version = version

  s.summary = "Ruby library to interface with the SQLite3 database engine (http://www.sqlite.org)."
  s.description = "Ruby library to interface with the SQLite3 database engine. " \
                  "Vendored into CosmoRuby and statically linked against Cosmopolitan's libsqlite3."
  s.homepage = "https://github.com/sparklemotion/sqlite3-ruby"
  s.licenses = ["BSD-3-Clause"]
  s.authors = ["Jamis Buck", "Luis Lavena", "Aaron Patterson", "Mike Dalessio"]

  s.metadata = {
    "homepage_uri" => "https://github.com/sparklemotion/sqlite3-ruby",
    "bug_tracker_uri" => "https://github.com/sparklemotion/sqlite3-ruby/issues",
    "documentation_uri" => "https://sparklemotion.github.io/sqlite3-ruby/",
    "changelog_uri" => "https://github.com/sparklemotion/sqlite3-ruby/blob/master/CHANGELOG.md",
    "source_code_uri" => "https://github.com/sparklemotion/sqlite3-ruby"
  }

  s.required_ruby_version = Gem::Requirement.new(">= 3.2")

  s.files = [
    "lib/sqlite3.rb",
    "lib/sqlite3/constants.rb",
    "lib/sqlite3/database.rb",
    "lib/sqlite3/errors.rb",
    "lib/sqlite3/fork_safety.rb",
    "lib/sqlite3/pragmas.rb",
    "lib/sqlite3/resultset.rb",
    "lib/sqlite3/statement.rb",
    "lib/sqlite3/value.rb",
    "lib/sqlite3/version.rb",
    "lib/sqlite3/version_info.rb"
  ]
  s.require_paths = ["lib"]
end
