%# -*- C -*-
% extinits = ARGV.map {|n| [n.tr('/', '_'), n]}
#include "ruby/ruby.h"
#include "ruby/config.h"

#define init(func, name) {	\
    extern void func(void);	\
    ruby_init_ext(name DLEXT, func); \
}

void ruby_init_ext(const char *name, void (*init)(void));

void Init_ext(void)
{
% extinits.each do |f, n|
    init(Init_<%=f%>, <%=n.dump%>);
% end
}
