#!/bin/sh
# Build a fat APE binary (x86_64 + aarch64) from a Makefile target.
#
# Usage:
#   ./bake o//examples/hello
#   ./bake o//third_party/ruby/ruby
#   ./bake -j8 o//examples/hello        # pass flags to make
#
# Output:
#   <target>.com in the current directory (e.g. hello.com, ruby.com)
#
# What it does:
#   1. make <target>              -- builds x86_64
#   2. make m=aarch64 <target>    -- builds aarch64
#   3. apelink                    -- combines into fat binary

set -e

COSMOCC=".cosmocc/current/bin"
APELINK="$COSMOCC/apelink"
APE_X86="$COSMOCC/ape-x86_64.elf"
APE_ARM="$COSMOCC/ape-aarch64.elf"
APE_M1="$COSMOCC/ape-m1.c"

# ── Parse arguments ──────────────────────────────────────────────────
# Everything before the last argument is make flags.
# The last argument is the target.

if [ $# -eq 0 ]; then
    echo "Usage: ./bake [make-flags] <target>"
    echo ""
    echo "Examples:"
    echo "  ./bake o//examples/hello"
    echo "  ./bake -j8 o//examples/hello"
    echo "  ./bake -j8 o//third_party/ruby/ruby"
    exit 1
fi

# Last argument is the target
TARGET=""
MAKE_FLAGS=""
for arg in "$@"; do
    if [ -n "$TARGET" ]; then
        MAKE_FLAGS="$MAKE_FLAGS $TARGET"
    fi
    TARGET="$arg"
done

# Derive the aarch64 target path: o//<path> -> o/aarch64/<path>
ARM_TARGET=$(echo "$TARGET" | sed 's|^o//|o/aarch64/|; s|^o/[^/]*/|o/aarch64/|')

# Derive the .dbg paths
X86_DBG="$TARGET.dbg"
ARM_DBG="$ARM_TARGET.dbg"

# Derive output name from target basename
BASENAME=$(basename "$TARGET")
OUTPUT="${BASENAME}.com"

# ── Preflight checks ────────────────────────────────────────────────

if [ ! -f "$APELINK" ]; then
    echo "Error: apelink not found at $APELINK"
    echo "Run 'make' once to download the cosmocc toolchain."
    exit 1
fi

if [ ! -f "$APE_X86" ]; then
    echo "Error: APE x86_64 loader not found at $APE_X86"
    exit 1
fi

if [ ! -f "$APE_ARM" ]; then
    echo "Error: APE aarch64 loader not found at $APE_ARM"
    exit 1
fi

echo "=== bake: building fat APE binary ==="
echo "Target:  $TARGET"
echo "Output:  $OUTPUT"
echo ""

# ── Step 1: Build x86_64 ────────────────────────────────────────────

echo "--- Step 1/3: Building x86_64 ---"
# shellcheck disable=SC2086
make $MAKE_FLAGS "$TARGET"

if [ ! -f "$X86_DBG" ]; then
    echo "Error: x86_64 build succeeded but $X86_DBG not found."
    echo "The target may not produce a .dbg file."
    exit 1
fi

echo ""

# ── Step 2: Build aarch64 ───────────────────────────────────────────

echo "--- Step 2/3: Building aarch64 ---"
# shellcheck disable=SC2086
make $MAKE_FLAGS m=aarch64 "$ARM_TARGET"

if [ ! -f "$ARM_DBG" ]; then
    echo "Error: aarch64 build succeeded but $ARM_DBG not found."
    echo "The target may not produce a .dbg file."
    exit 1
fi

echo ""

# ── Step 3: Link fat binary ─────────────────────────────────────────

echo "--- Step 3/3: Linking fat binary ---"
"$APELINK" \
    -o "$OUTPUT" \
    -l "$APE_X86" \
    -l "$APE_ARM" \
    -M "$APE_M1" \
    "$X86_DBG" \
    "$ARM_DBG"

echo ""

# ── Verify ───────────────────────────────────────────────────────────

if [ ! -f "$OUTPUT" ]; then
    echo "Error: apelink did not produce $OUTPUT"
    exit 1
fi

echo "=== Done ==="
echo "Output: $OUTPUT ($(wc -c < "$OUTPUT" | tr -d ' ') bytes)"

. ./check_ape.sh
check_ape_magic "$OUTPUT"
check_fat_binary "$OUTPUT" "$TARGET" "$ARM_TARGET"
check_ape_components "$OUTPUT"
