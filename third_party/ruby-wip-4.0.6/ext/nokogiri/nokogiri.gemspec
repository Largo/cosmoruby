# frozen_string_literal: true
#
# Static gemspec for the nokogiri gem as vendored into CosmoRuby.
#
# Same reasoning as ext/sqlite3/sqlite3.gemspec: the upstream gemspec is
# generated by Rake, and the C extension is compiled statically into ruby.com
# rather than built by RubyGems. assemble_stdlib.sh scans
# third_party/ruby/{lib,ext} for *.gemspec files and installs each as a
# *default gem* specification under
# /zip/lib/ruby/gems/4.0.0/specifications/default/, which is what makes
# `gem list`, Bundler and ocran see nokogiri as provided by the interpreter.
#
# NOTE: no `extensions` and no dependency on mini_portile2 -- the native part
# is already linked in, and mini_portile2 only exists upstream to build the
# bundled libxml2/libxslt. CosmoRuby links against third_party/libxml2 and
# third_party/libxslt, which are the same versions nokogiri 1.19.4 pins.

version = File.foreach(File.join(__dir__, "lib/nokogiri/version/constant.rb")) do |line|
  /^\s*VERSION\s*=\s*"(.*)"/ =~ line and break $1
end rescue nil

Gem::Specification.new do |s|
  s.name = "nokogiri"
  s.version = version

  s.summary = "Nokogiri (鋸) makes it easy and painless to work with XML and HTML from Ruby."
  s.description = "Nokogiri parses and searches XML/HTML. Vendored into CosmoRuby and " \
                  "statically linked against third_party/libxml2 and third_party/libxslt."
  s.homepage = "https://nokogiri.org"
  s.licenses = ["MIT"]
  s.authors = ["Mike Dalessio", "Aaron Patterson", "Yoko Harada", "Akinori MUSHA",
               "John Shahid", "Karol Bucek", "Sam Ruby", "Craig Barnes",
               "Stephen Checkoway", "Lars Kanis", "Sergio Arbeo", "Timothy Elliott",
               "Nobuyoshi Nakada"]

  s.metadata = {
    "homepage_uri" => "https://nokogiri.org",
    "bug_tracker_uri" => "https://github.com/sparklemotion/nokogiri/issues",
    "documentation_uri" => "https://nokogiri.org/rdoc/index.html",
    "changelog_uri" => "https://nokogiri.org/CHANGELOG.html",
    "source_code_uri" => "https://github.com/sparklemotion/nokogiri"
  }

  s.required_ruby_version = Gem::Requirement.new(">= 3.2")

  s.files = Dir.chdir(__dir__) { Dir["lib/**/*.rb"] }
  s.require_paths = ["lib"]
end
