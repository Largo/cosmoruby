PKGS += THIRD_PARTY_TOMLC99

THIRD_PARTY_TOMLC99_ARTIFACTS += THIRD_PARTY_TOMLC99_A
THIRD_PARTY_TOMLC99 = $(THIRD_PARTY_TOMLC99_A_DEPS) $(THIRD_PARTY_TOMLC99_A)
THIRD_PARTY_TOMLC99_A = o/$(MODE)/third_party/tomlc99/tomlc99.a
THIRD_PARTY_TOMLC99_A_FILES := $(wildcard third_party/tomlc99/*)
THIRD_PARTY_TOMLC99_A_HDRS = $(filter %.h,$(THIRD_PARTY_TOMLC99_A_FILES))
THIRD_PARTY_TOMLC99_A_SRCS = $(filter %.c,$(THIRD_PARTY_TOMLC99_A_FILES))

THIRD_PARTY_TOMLC99_A_OBJS =			\
	$(THIRD_PARTY_TOMLC99_A_SRCS:%.c=o/$(MODE)/%.o)

THIRD_PARTY_TOMLC99_A_CHECKS =			\
	$(THIRD_PARTY_TOMLC99_A).pkg		\
	$(THIRD_PARTY_TOMLC99_A_HDRS:%=o/$(MODE)/%.ok)

THIRD_PARTY_TOMLC99_A_DIRECTDEPS =		\
	LIBC_FMT				\
	LIBC_INTRIN				\
	LIBC_MEM				\
	LIBC_STDIO				\
	LIBC_STR				\
	LIBC_SYSV				\
	THIRD_PARTY_GDTOA

THIRD_PARTY_TOMLC99_A_DEPS :=			\
	$(call uniq,$(foreach x,$(THIRD_PARTY_TOMLC99_A_DIRECTDEPS),$($(x))))

$(THIRD_PARTY_TOMLC99_A):			\
		third_party/tomlc99/		\
		$(THIRD_PARTY_TOMLC99_A).pkg	\
		$(THIRD_PARTY_TOMLC99_A_OBJS)

$(THIRD_PARTY_TOMLC99_A).pkg:			\
		$(THIRD_PARTY_TOMLC99_A_OBJS)	\
		$(foreach x,$(THIRD_PARTY_TOMLC99_A_DIRECTDEPS),$($(x)_A).pkg)

THIRD_PARTY_TOMLC99_LIBS = $(foreach x,$(THIRD_PARTY_TOMLC99_ARTIFACTS),$($(x)))
THIRD_PARTY_TOMLC99_SRCS = $(foreach x,$(THIRD_PARTY_TOMLC99_ARTIFACTS),$($(x)_SRCS))
THIRD_PARTY_TOMLC99_HDRS = $(foreach x,$(THIRD_PARTY_TOMLC99_ARTIFACTS),$($(x)_HDRS))
THIRD_PARTY_TOMLC99_CHECKS = $(foreach x,$(THIRD_PARTY_TOMLC99_ARTIFACTS),$($(x)_CHECKS))
THIRD_PARTY_TOMLC99_OBJS = $(foreach x,$(THIRD_PARTY_TOMLC99_ARTIFACTS),$($(x)_OBJS))

.PHONY: o/$(MODE)/third_party/tomlc99
o/$(MODE)/third_party/tomlc99:			\
		$(THIRD_PARTY_TOMLC99_CHECKS)
