#!/bin/sh
# Build fat APE binaries (x86_64 + aarch64) from Makefile targets.
#
# Usage:
#   ./bake o//examples/hello
#   ./bake o//third_party/ruby/ruby o//third_party/ruby/irb
#   ./bake -j8 o//third_party/ruby/ruby o//third_party/ruby/irb
#
# Output:
#   releases/<target>.com (e.g. releases/hello.com, releases/ruby.com)
#
# What it does for each target:
#   1. make <target>              -- builds x86_64
#   2. make m=aarch64 <target>    -- builds aarch64
#   3. apelink                    -- combines into fat binary

set -e

COSMOCC=".cosmocc/current/bin"
APELINK="$COSMOCC/apelink"
APE_X86="$COSMOCC/ape-x86_64.elf"
APE_ARM="$COSMOCC/ape-aarch64.elf"
APE_M1="$COSMOCC/ape-m1.c"

# ── Parse arguments ──────────────────────────────────────────────────
# Make flags start with - (e.g. -j8, -k).
# Targets start with o/ (e.g. o//examples/hello).

MAKE_FLAGS=""
TARGETS=""
TARGET_COUNT=0

for arg in "$@"; do
    case "$arg" in
        -*)
            MAKE_FLAGS="$MAKE_FLAGS $arg"
            ;;
        o/*)
            TARGETS="$TARGETS $arg"
            TARGET_COUNT=$((TARGET_COUNT + 1))
            ;;
        *)
            # Could be a make variable (e.g. RUBY_TEST_EXTENSIONS=1)
            MAKE_FLAGS="$MAKE_FLAGS $arg"
            ;;
    esac
done

if [ "$TARGET_COUNT" -eq 0 ]; then
    echo "Usage: ./bake [make-flags] <target> [target...]"
    echo ""
    echo "Examples:"
    echo "  ./bake o//examples/hello"
    echo "  ./bake -j8 o//third_party/ruby/ruby o//third_party/ruby/irb"
    exit 1
fi

# ── Preflight checks ────────────────────────────────────────────────

if [ ! -f "$APELINK" ]; then
    echo "Error: apelink not found at $APELINK"
    echo "Run 'make' once to download the cosmocc toolchain."
    exit 1
fi

if [ ! -f "$APE_X86" ]; then
    echo "Error: APE x86_64 loader not found at $APE_X86"
    exit 1
fi

if [ ! -f "$APE_ARM" ]; then
    echo "Error: APE aarch64 loader not found at $APE_ARM"
    exit 1
fi

. ./check_ape.sh

# ── make, verified ────────────────────────────────────────────────────
#
# `make` in this tree can exit 0 without having linked anything, and it
# fails transiently.  So never believe $?: re-run make until the product
# exists and has converged (its size:mtime stops changing).  MAX_ATTEMPTS=1
# restores the old believe-$?-once behaviour.

MAX_ATTEMPTS="${MAX_ATTEMPTS:-4}"

# verified_make <product> <make args...>
# Runs make until <product> exists and its size:mtime signature is unchanged
# by a further make run -- i.e. the build has converged.  Two attempts is the
# normal case: one builds, one confirms.
verified_make() {
    _product="$1"; shift
    _prev=""
    _attempt=1
    while [ "$_attempt" -le "$MAX_ATTEMPTS" ]; do
        # shellcheck disable=SC2086
        make "$@"
        _sig=$(stat -c '%s:%Y' "$_product" 2>/dev/null || echo "")
        if [ -n "$_sig" ] && [ "$_sig" = "$_prev" ]; then
            return 0
        fi
        [ -n "$_sig" ] || echo "bake: $_product not produced (attempt $_attempt/$MAX_ATTEMPTS)"
        _prev="$_sig"
        _attempt=$((_attempt + 1))
    done
    if [ -n "$_prev" ]; then
        echo "Warning: $_product still changing after $MAX_ATTEMPTS make attempts; using it anyway."
        return 0
    fi
    echo "Error: $_product was never produced after $MAX_ATTEMPTS make attempts."
    return 1
}

# ── Build and link each target ────────────────────────────────────────

STEP=0
TOTAL_STEPS=$((TARGET_COUNT * 3))
OUTPUTS=""

for TARGET in $TARGETS; do
    # Derive paths
    ARM_TARGET=$(echo "$TARGET" | sed 's|^o//|o/aarch64/|; s|^o/[^/]*/|o/aarch64/|')
    X86_DBG="$TARGET.dbg"
    ARM_DBG="$ARM_TARGET.dbg"
    BASENAME=$(basename "$TARGET")
    mkdir -p releases
    # Don't double-add .com if target already has it (e.g., mtsh.com -> mtsh.com, not mtsh.com.com)
    if [ "${BASENAME%.com}" != "$BASENAME" ]; then
        OUTPUT="releases/${BASENAME}"
    else
        OUTPUT="releases/${BASENAME}.com"
    fi

    echo "=== bake: $BASENAME ==="
    echo ""

    # Step 1: Build x86_64
    STEP=$((STEP + 1))
    echo "--- Step $STEP/$TOTAL_STEPS: Building $BASENAME x86_64 ---"
    # shellcheck disable=SC2086
    verified_make "$X86_DBG" $MAKE_FLAGS "$TARGET" || exit 1
    echo ""

    # Step 2: Build aarch64
    STEP=$((STEP + 1))
    echo "--- Step $STEP/$TOTAL_STEPS: Building $BASENAME aarch64 ---"
    # shellcheck disable=SC2086
    verified_make "$ARM_DBG" $MAKE_FLAGS m=aarch64 "$ARM_TARGET" || exit 1
    echo ""

    # Step 3: Link fat binary
    STEP=$((STEP + 1))
    echo "--- Step $STEP/$TOTAL_STEPS: Linking $OUTPUT ---"
    "$APELINK" \
        -o "$OUTPUT" \
        -l "$APE_X86" \
        -l "$APE_ARM" \
        -M "$APE_M1" \
        "$X86_DBG" \
        "$ARM_DBG"
    echo ""

    # Verify
    if [ ! -f "$OUTPUT" ]; then
        echo "Error: apelink did not produce $OUTPUT"
        exit 1
    fi

    check_ape_magic "$OUTPUT"
    check_fat_binary "$OUTPUT" "$TARGET" "$ARM_TARGET"
    check_ape_components "$OUTPUT"
    echo ""

    OUTPUTS="$OUTPUTS $OUTPUT"
done

# ── Summary ───────────────────────────────────────────────────────────

echo "=== All done ==="
for OUT in $OUTPUTS; do
    SIZE=$(wc -c < "$OUT" | tr -d ' ')
    echo "  $OUT ($SIZE bytes)"
done
