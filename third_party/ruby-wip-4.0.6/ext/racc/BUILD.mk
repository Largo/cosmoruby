#-*-mode:makefile-gmake;indent-tabs-mode:t;tab-width:8;coding:utf-8-*-┐
#── vi: set noet ft=make ts=8 sw=8 fenc=utf-8 :vi ────────────────────┘
#
# OVERVIEW
#
#   racc 1.8.1 ruby gem -- the `racc/cparse` native runtime, statically
#   linked.
#
# NOTES
#
#   Sources come from the `racc` rubygem (see README.cosmo).  This is the same
#   version Ruby 4.0.6 bundles under .bundle/gems/racc-1.8.1, byte for byte.
#   racc ships with Ruby as a *bundled* gem whose gemspec the CosmoRuby build
#   never installed, because it declares a C extension.  That is the gap this
#   directory closes: the extension is linked in, and ext/racc/racc.gemspec
#   makes RubyGems (and ocran's payload-provides check) see the gem.
#
#   racc/parser.rb requires 'racc/cparse' and falls back to a pure-Ruby parse
#   engine if that fails, so this archive is a *speed* win, not a correctness
#   one.  Anything generated by racc -- nokogiri's CSS selector parser, and in
#   Rails' dependency graph the `parser`/`i18n` family -- gets the C engine.
#
#   The only -D extconf.rb produces is RACC_INFO_VERSION, which cparse.c
#   stringizes into Racc::Parser::Racc_Runtime_Core_Version_C.  It MUST match
#   Racc::VERSION in lib/racc/info.rb, or racc/parser.rb decides the extension
#   is stale ("old cparse.so") and silently falls back to Ruby.
#
#     HAVE_RB_EXT_RACTOR_SAFE   ruby >= 3.0 -> yes (cparse.c marks itself
#                               ractor-safe under this guard)

PKGS += THIRD_PARTY_RUBY_EXT_RACC

THIRD_PARTY_RUBY_EXT_RACC_A = o/$(MODE)/third_party/ruby/ext/racc/racc.a
THIRD_PARTY_RUBY_EXT_RACC_FILES :=					\
	$(wildcard third_party/ruby/ext/racc/cparse/*)
THIRD_PARTY_RUBY_EXT_RACC_HDRS =					\
	$(filter %.h,$(THIRD_PARTY_RUBY_EXT_RACC_FILES))

THIRD_PARTY_RUBY_EXT_RACC_SRCS =					\
	third_party/ruby/ext/racc/cparse/cparse.c

THIRD_PARTY_RUBY_EXT_RACC_OBJS =					\
	$(THIRD_PARTY_RUBY_EXT_RACC_SRCS:%.c=o/$(MODE)/%.o)

$(THIRD_PARTY_RUBY_EXT_RACC_A):						\
		$(THIRD_PARTY_RUBY_EXT_RACC_OBJS)

o/$(MODE)/third_party/ruby/ext/racc/%.o: private				\
	CFLAGS +=							\
		-Ithird_party/ruby/include				\
		-Ithird_party/ruby					\
		-DRUBY_EXPORT						\
		-DRUBY_COSMOPOLITAN					\
		-DRACC_INFO_VERSION=1.8.1

$(THIRD_PARTY_RUBY_EXT_RACC_OBJS):					\
	$(THIRD_PARTY_RUBY_EXT_RACC_HDRS) third_party/ruby/ext/racc/BUILD.mk

.PHONY: o/$(MODE)/third_party/ruby/ext/racc
o/$(MODE)/third_party/ruby/ext/racc: $(THIRD_PARTY_RUBY_EXT_RACC_A)
